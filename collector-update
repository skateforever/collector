#!/bin/bash
# collector-update — pull latest changes and rebuild the Docker image
#
# Usage:
#   collector-update              # pull + rebuild
#   collector-update --build-only # skip pull, just rebuild
#   collector-update --pull-only  # pull without rebuilding
#
# This script ensures the Docker image always matches the repository state.
# Run it after a git pull, or let it handle both steps automatically.
#
# Environment variables:
#   COLLECTOR_IMAGE  — image name:tag (default: collector:latest)
#   DOCKERFILE       — Dockerfile to use (default: Dockerfile)
#   BUILD_ARGS       — extra docker build arguments (e.g. --no-cache)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

COLLECTOR_IMAGE="${COLLECTOR_IMAGE:-collector:latest}"
DOCKERFILE="${DOCKERFILE:-Dockerfile}"
BUILD_ARGS="${BUILD_ARGS:-}"

do_pull=true
do_build=true
force_build=false

for arg in "$@"; do
    case "${arg}" in
        --build-only) do_pull=false; force_build=true ;;
        --pull-only)  do_build=false ;;
        --force-build) force_build=true ;;
        --no-cache)   BUILD_ARGS="--no-cache ${BUILD_ARGS}" ;;
        --help|-h)
            echo "Usage: collector-update [--build-only] [--pull-only] [--force-build] [--no-cache]"
            echo ""
            echo "  --build-only   Skip git pull, only rebuild the Docker image"
            echo "  --pull-only    Pull changes without rebuilding"
            echo "  --force-build  Rebuild even if no structural changes detected"
            echo "  --no-cache     Pass --no-cache to docker build"
            echo ""
            echo "The image is only rebuilt when structural files change (Dockerfiles,"
            echo "binary dependencies). Script changes are picked up automatically via"
            echo "host volume mounts in collector-docker."
            echo ""
            echo "Environment:"
            echo "  COLLECTOR_IMAGE=${COLLECTOR_IMAGE}"
            echo "  DOCKERFILE=${DOCKERFILE}"
            exit 0
            ;;
        *)
            echo "collector-update: unknown option '${arg}'" >&2
            echo "  run 'collector-update --help' for usage" >&2
            exit 1
            ;;
    esac
done

# Files that require a Docker image rebuild (binary/package changes).
# Script-only changes are served via volume mounts and don't need a rebuild.
STRUCTURAL_PATTERNS="Dockerfile|functions/check_binaries.sh"

if [[ "${do_pull}" == true ]]; then
    echo "==> Pulling latest changes..."
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    before="$(git rev-parse HEAD)"
    git pull --ff-only origin "${current_branch}" || {
        echo "collector-update: git pull failed (non-fast-forward?)." >&2
        echo "  resolve manually, then re-run with --build-only" >&2
        exit 1
    }
    after="$(git rev-parse HEAD)"
    if [[ "${before}" == "${after}" ]]; then
        echo "    Already up to date (${after:0:7})."
        if [[ "${do_build}" == false ]]; then
            exit 0
        fi
    else
        echo "    Updated: ${before:0:7} -> ${after:0:7}"
        git --no-pager log --oneline "${before}..${after}"

        # Check if any structural files changed (requires image rebuild)
        structural_changed="$(git diff --name-only "${before}" "${after}" | grep -E "${STRUCTURAL_PATTERNS}" || true)"
        if [[ -n "${structural_changed}" ]]; then
            echo ""
            echo "    Structural changes detected (image rebuild needed):"
            echo "${structural_changed}" | sed 's/^/      /'
            force_build=true
        else
            echo ""
            echo "    Only script changes detected — no image rebuild needed."
            echo "    Scripts are mounted from host via collector-docker."
            if [[ "${force_build}" != true ]]; then
                do_build=false
            fi
        fi
    fi
fi

if [[ "${do_build}" == true ]] && [[ "${force_build}" == true ]]; then
    echo ""
    echo "==> Building Docker image: ${COLLECTOR_IMAGE}"
    echo "    Dockerfile: ${DOCKERFILE}"
    # shellcheck disable=SC2086
    if ! docker build ${BUILD_ARGS} -f "${DOCKERFILE}" -t "${COLLECTOR_IMAGE}" . 2>&1; then
        # Full build failed (registry unreachable, network issue, etc).
        # Fall back to Dockerfile.patch which layers on the existing image.
        if [[ -f "${SCRIPT_DIR}/Dockerfile.patch" ]] && docker image inspect "${COLLECTOR_IMAGE}" >/dev/null 2>&1; then
            echo ""
            echo "==> Full build failed. Falling back to Dockerfile.patch (scripts-only update)..."
            docker build ${BUILD_ARGS} -f "${SCRIPT_DIR}/Dockerfile.patch" -t "${COLLECTOR_IMAGE}" . || {
                echo "collector-update: patch build also failed." >&2
                exit 1
            }
        else
            echo "collector-update: build failed and no fallback available." >&2
            exit 1
        fi
    fi
    echo ""
    echo "==> Build complete: ${COLLECTOR_IMAGE}"
    docker images --format "    {{.Repository}}:{{.Tag}}  {{.Size}}  {{.CreatedAt}}" \
        | grep "${COLLECTOR_IMAGE%%:*}" | head -3
fi

if [[ "${do_build}" == true ]] && [[ "${force_build}" != true ]]; then
    echo ""
    echo "Done. No image rebuild needed — scripts are served from host volumes."
else
    echo ""
    echo "Done. Run 'collector-docker --help' to verify."
fi
