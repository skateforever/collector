# Docker Environment Configuration Template
# Copy this to .env and customize values as needed
#
# Usage:
#   cp support/docker/docker.env.template .env
#   # Edit .env with your values
#   docker compose run --rm collector -d example.com --recon
#   # or
#   source .env && collector-docker -d example.com --recon

# Docker image to use
COLLECTOR_IMAGE=collector:latest

# Host directories to mount
OUTPUTS_DIR=./outputs
WORDLISTS_DIR=./wordlists
CONF_D_DIR=./conf.d

# Alert Provider Configuration
# Specify which alert provider to use:
#   discord, slack, teams, telegram, signal
# Then set the corresponding config file path
ALERT_PROVIDER_TYPE=discord
ALERT_PROVIDER_FILE=./discord-provider.yaml

# Dashboard host address/port override — for collector-docker only.
# Only takes effect with -ru|--report-up, and only overrides THIS
# invocation: the real source of truth is web_report_host_address /
# web_report_host_port in conf.d/operation.conf — set them there to
# change the default permanently; use these two only for a one-off
# override. WEB_REPORT_HOST_ADDRESS reaches the dashboard from another
# machine when set to that machine's LAN/public IP, or 0.0.0.0 for every
# interface — the printed dashboard URL uses this same value, so it
# stays reachable from where you're opening it. WEB_REPORT_HOST_PORT is
# for when the externally-published port needs to differ from the
# container's internal web_report_container_port.
#WEB_REPORT_HOST_ADDRESS=127.0.0.1
#WEB_REPORT_HOST_PORT=8000

# Dashboard port — for docker-compose.yaml's `ports:` mapping only. Not
# the same variable as WEB_REPORT_HOST_PORT above (that one is
# collector-docker-only; collector-docker ignores this one and derives
# the port from conf.d/operation.conf's web_report_container_port
# directly). Must match web_report_container_port on both sides
# if you change it — see the comment above `ports:` in
# docker-compose.yaml. docker-compose.yaml's `ports:` also reads
# WEB_REPORT_HOST_ADDRESS (same variable as above) for the publish-side
# IP, defaulting to 127.0.0.1.
WEB_REPORT_CONTAINER_PORT=8000

# Container name for --report-up/--mcp-up mode (shared by both)
COLLECTOR_CONTAINER_NAME=collector-reconnaissance
