# Docker Environment Configuration Template
# Copy this to .env and customize values as needed
#
# Usage:
#   cp support/docker/docker.env.template .env
#   # Edit .env with your values
#   docker compose run --rm collector -d example.com --recon
#   # or
#   source .env && collector-docker -d example.com --recon

# Docker image to use
COLLECTOR_IMAGE=collector:latest

# Host directories to mount
OUTPUTS_DIR=./outputs
WORDLISTS_DIR=./wordlists
COLLECTOR_CFG=./collector.cfg

# Alert Provider Configuration
# Specify which alert provider to use:
#   discord, slack, teams, telegram, signal
# Then set the corresponding config file path
ALERT_PROVIDER_TYPE=discord
ALERT_PROVIDER_FILE=./discord-provider.yaml

# Dashboard port mapping
APP_PORT=127.0.0.1:8000:8000

# Container name for report-only mode
REPORT_CONTAINER_NAME=collector-report
