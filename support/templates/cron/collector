# =============================================================================
# collector — cron schedule (Docker)
# =============================================================================
#
# collector runs exclusively inside a Docker container. Each cron entry fires
# an ephemeral `docker run --rm` — the container is born, runs collector, and
# is destroyed. Results persist via the /opt/collector/outputs volume.
#
# Drop this file into /etc/cron.d/collector (preferred) or splice the entries
# into the crontab of the user that should run collector:
#
#     sudo install -m 0644 collector-cron /etc/cron.d/collector
#
# Pre-requisites:
#   1. Build the image once (or pull from your registry):
#        docker build -t collector:latest /opt/collector
#   2. The user running cron must belong to the docker group:
#        sudo usermod -aG docker collector
#
# Notes:
#   * /etc/cron.d entries take a USER column (between schedule and command),
#     unlike user crontabs. Adjust if you paste these into `crontab -e`.
#   * Times are LOCAL to the machine. Verify with `timedatectl`.
#   * The leading sleep introduces jitter so a fleet of hosts/targets does
#     not hammer OSINT APIs at the exact same minute.
#   * Adjust volume paths and image name below to your install.
# -----------------------------------------------------------------------------

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# .------------ minute (0-59)
# |   .--------- hour (0-23)
# |   |   .------ day of month (1-31)
# |   |   |   .--- month (1-12)
# |   |   |   |  .- day of week (0-6, Sun=0)
# |   |   |   |  |  user        command
# v   v   v   v  v  v           v

# -----------------------------------------------------------------------------
# DAILY recon (light): subdomain discovery + alive + tech detection.
# Each target runs at a slightly different minute to spread load. Add up to
# ~30 min of random jitter via the leading `sleep $((RANDOM % 1800))`.
# -----------------------------------------------------------------------------
0  3  *  *  *  collector  sleep $((RANDOM \% 1800)) && /usr/bin/docker run --rm --name collector-acme     -v /opt/collector/outputs:/opt/collector/outputs -v /opt/collector/wordlists:/opt/collector/wordlists -v /opt/collector/collector.cfg:/opt/collector/collector.cfg:ro collector:latest -d acme.com    --recon --webapp-discovery >> /var/log/collector/acme.log    2>&1
5  3  *  *  *  collector  sleep $((RANDOM \% 1800)) && /usr/bin/docker run --rm --name collector-example  -v /opt/collector/outputs:/opt/collector/outputs -v /opt/collector/wordlists:/opt/collector/wordlists -v /opt/collector/collector.cfg:/opt/collector/collector.cfg:ro collector:latest -d example.org --recon --webapp-discovery >> /var/log/collector/example.log 2>&1

# Or, if you keep targets in a list file (one domain per line, # for comments):
# 30 3 *  *  *  collector  sleep $((RANDOM \% 1800)) && /usr/bin/docker run --rm --name collector-list -v /opt/collector/outputs:/opt/collector/outputs -v /opt/collector/wordlists:/opt/collector/wordlists -v /opt/collector/collector.cfg:/opt/collector/collector.cfg:ro collector:latest -dl /opt/collector/outputs/targets.list --recon --webapp-discovery >> /var/log/collector/list.log 2>&1

# -----------------------------------------------------------------------------
# WEEKLY heavy run: enum (gobuster/dirsearch) + full nuclei pass.
# Sunday 02:00, with up to 1h of jitter. Skip these on the daily slot to keep
# it fast and to avoid hammering OSINT API quotas.
# -----------------------------------------------------------------------------
0  2  *  *  0  collector  sleep $((RANDOM \% 3600)) && /usr/bin/docker run --rm --name collector-acme-heavy    -v /opt/collector/outputs:/opt/collector/outputs -v /opt/collector/wordlists:/opt/collector/wordlists -v /opt/collector/collector.cfg:/opt/collector/collector.cfg:ro collector:latest -d acme.com    --recon --webapp-discovery --webapp-enum --webapp-scan >> /var/log/collector/acme-weekly.log    2>&1
0  2  *  *  0  collector  sleep $((RANDOM \% 3600)) && /usr/bin/docker run --rm --name collector-example-heavy -v /opt/collector/outputs:/opt/collector/outputs -v /opt/collector/wordlists:/opt/collector/wordlists -v /opt/collector/collector.cfg:/opt/collector/collector.cfg:ro collector:latest -d example.org --recon --webapp-discovery --webapp-enum --webapp-scan >> /var/log/collector/example-weekly.log 2>&1

# -----------------------------------------------------------------------------
# Housekeeping: prune run directories older than 60 days. Compress before
# delete so you keep a long tail of summaries (history.csv lives at the
# domain root and is not touched by this).
# -----------------------------------------------------------------------------
0  4  *  *  *  collector  find /opt/collector/outputs -mindepth 2 -maxdepth 2 -type d -mtime +60 -print -exec tar -czf {}.tar.gz -C $(dirname {}) $(basename {}) \; -exec rm -rf {} \; >> /var/log/collector/housekeeping.log 2>&1
