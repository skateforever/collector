# =============================================================================
# collector — systemd service + timer
# =============================================================================
#
# This file bundles BOTH unit fragments (service + timer) so they can live
# alongside the script in the repo. To install on a Linux host with systemd:
#
#   1. Copy each block below into its own file under /etc/systemd/system/:
#        /etc/systemd/system/collector@.service
#        /etc/systemd/system/collector@.timer
#      The '@' makes them template units — a single copy serves every target.
#
#   2. Reload systemd:
#        sudo systemctl daemon-reload
#
#   3. Enable + start a timer per target. The instance name is the domain
#      (with '/' or other systemd-illegal chars escaped via systemd-escape):
#
#        sudo systemctl enable --now collector@acme.com.timer
#        sudo systemctl enable --now collector@example.org.timer
#
#   4. Inspect:
#        systemctl list-timers 'collector@*'
#        journalctl -u collector@acme.com.service --since today
#
#   5. Manual run (out of schedule):
#        sudo systemctl start collector@acme.com.service
#
# Edit COLLECTOR_USER, COLLECTOR_HOME, and the OnCalendar expression to match
# your environment before installing. The defaults assume:
#   * binary lives at /opt/collector/collector
#   * runs as the 'collector' service user
#   * fires every day at 03:00 local time, with up to 30 min of jitter
# -----------------------------------------------------------------------------


# =============================================================================
# /etc/systemd/system/collector@.service
# =============================================================================
[Unit]
Description=collector reconnaissance run for %i
Documentation=https://github.com/skate4ever/collector
# Don't start before the network is actually reachable (DNS, OSINT APIs).
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=collector
Group=collector
WorkingDirectory=/opt/collector

# %i is the unescaped instance name (the target domain). Pass --recon plus
# whatever phases you want in the daily run. Heavy phases (--webapp-enum,
# --webapp-scan) are best left to a separate weekly timer; see comments at
# the bottom of this file for that pattern.
ExecStart=/opt/collector/collector -d %i --recon --webapp-discovery

# Cap a single run so a stuck OSINT API can't pin the slot forever.
TimeoutStartSec=4h

# Harden the unit a bit. collector needs network and write access to its
# own output dir, but nothing more.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/collector
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

# All output goes to journald; query with: journalctl -u collector@<target>.service
StandardOutput=journal
StandardError=journal

# Don't restart on success (oneshot). Notify failures to the recon channel
# via the sister OnFailure unit if you wire one up.
Restart=no

[Install]
WantedBy=multi-user.target


# =============================================================================
# /etc/systemd/system/collector@.timer
# =============================================================================
[Unit]
Description=Daily collector recon for %i
Requires=collector@%i.service

[Timer]
# Daily at 03:00 local time. Edit to taste:
#   "*-*-* 03:00:00"            once a day at 03:00
#   "Mon *-*-* 02:00:00"        Mondays at 02:00
#   "*-*-* 03,15:00:00"         twice a day at 03:00 and 15:00
OnCalendar=*-*-* 03:00:00

# Spread targets so a fleet of timers doesn't hammer OSINT APIs at the
# same instant. Up to 30 minutes of jitter per target.
RandomizedDelaySec=30m

# If the host was off at 03:00, run the missed slot on next boot.
Persistent=true

# Optional: only run when on AC power / non-metered network.
# ConditionACPower=true

Unit=collector@%i.service

[Install]
WantedBy=timers.target


# =============================================================================
# OPTIONAL: weekly heavy run
# =============================================================================
# For phases that are too expensive to run every day (--webapp-enum, full
# nuclei sweep, etc.), drop a second pair of units that calls collector
# with the heavier flags and fires once a week:
#
#   /etc/systemd/system/collector-heavy@.service
#     ExecStart=/opt/collector/collector -d %i --recon --webapp-discovery \
#                                              --webapp-enum --webapp-scan
#
#   /etc/systemd/system/collector-heavy@.timer
#     OnCalendar=Sun *-*-* 02:00:00
#     RandomizedDelaySec=1h
#     Persistent=true
#     Unit=collector-heavy@%i.service
#
# Daily timers send ratchet updates (Δ subdomains, Δ IPs, new vhosts) over
# the 'recon' notify channel; weekly timers refresh the deeper artifacts.
