#!/bin/bash
#######################################################
#                                                     #
# collector is my script for reconnaissance during    #
# my job as pentester or as a hobby doing bug bounty  #
#                                                     #
#######################################################

collector_command_line="$0 $*"
collector_path=$(dirname "$0")

[[ -s "${collector_path}/functions/utils.sh" ]] && source "${collector_path}/functions/utils.sh"
banner
reset_vars

if [ -s "${collector_path}/collector.cfg" ]; then
    source "${collector_path}/collector.cfg"
else
    banner
    echo -e "Please ${red}make sure${reset} you have the ${yellow}collector.cfg${reset} file."
    echo -e "${yellow}You need this to set the tools parameters${reset}!"
    echo -e "You will set aquatone, gobuster, dirsearch threads and others.\n"
    exit 1
fi

# Checking if the essencial functions there are
for file in check_binaries.sh usage.sh message.sh menu.sh check_structure.sh \
    check_execution.sh domains_sources.sh files.sh diff.sh infra.sh webapp_crawler.sh \
    webapp_discovery.sh webapp_enum.sh git.sh emails_recon.sh \
    domains_recon.sh url_recon.sh; do
    function="${collector_path}/functions/${file}"
    if [ -s "${function}" ]; then
        source "${function}"
    else
        echo -e "Please ${red}make sure${reset} you have the ${yellow}\"${function}\"${reset} file."
        echo -e "${yellow}You need this file to execute collector${reset}!"
        echo -e "The collector execution ${red}failed${reset} at ${yellow}$(date +"%Y%m%d %H:%M")${reset} due missing essentials files!"
        exit 1
    fi
done

# Source the scanners (network + web) — these are called by
# domains_recon / url_recon, which were already sourced above, so the
# function definitions must land in the shell before either runs.
for scan in acunetix.sh nmap.sh nuclei.sh shodan.sh; do
    scan_file="${collector_path}/scans/${scan}"
    if [ -s "${scan_file}" ]; then
        source "${scan_file}"
    else
        echo -e "Please ${red}make sure${reset} you have the ${yellow}\"${scan_file}\"${reset} file."
        echo -e "${yellow}You need this file to execute collector${reset}!"
        echo -e "The collector execution ${red}failed${reset} at ${yellow}$(date +"%Y%m%d %H:%M")${reset} due missing scanner files!"
        exit 1
    fi
done
unset scan scan_file

check_container
check_binaries

[[ $# -eq 0 ]] && { echo -e "You're using the collector without parameters.\n" ; usage ; } || menu "$@"

# --report-stop / --report-only short-circuit every step below (target
# validation, lock acquisition, directory creation, recon). The app-report
# Flask app is strictly read-only over the existing outputs/, so there's
# nothing to validate here beyond what start_app_report_foreground already
# checks (DB present, app-report dir present). exec inside that function
# replaces this shell with gunicorn — Ctrl-C then reaches gunicorn directly.
#
# --report-stop is checked FIRST so `collector --report-only --report-stop`
# means "stop, don't start" instead of racing on the pidfile.
if [[ "${report_stop_check}" == "yes" ]]; then
    stop_app_report_foreground
    exit $?
fi

if [[ "${report_only_check}" == "yes" ]]; then
    start_app_report_foreground
    exit $?
fi

check_execution
check_parameter_conflicts
check_directory_permission

# Note: -k/--kill and -kr/--kill-remove were removed. The collector runs
# inside a one-shot Docker container, so the right way to stop a run is
# `docker stop <container>` on the host. To wipe artifacts, `rm -rf` the
# mounted volume from the host. The flock-based lock in
# collector_acquire_lock() already prevents concurrent runs on the same
# target, so the kill flow had no real use case (report C-01/C-07/C-08).

# check_parameter_dependency() inspects ${report_dir}/*.txt to decide
# whether reuse-mode operations have the artifacts they need. It must run
# AFTER create_directory_structure() so report_dir is defined. Previously
# it ran before, with report_dir empty, which made every reuse-without-r
# invocation trigger usage() (report C-02).
if [[ "${domain_check}" == "yes" && -n "${domain}" ]]; then
    collector_acquire_lock "${domain}"
    check_is_known_target "${domain}"
    create_directory_structure
    check_parameter_dependency
    domains_recon
    exit 0
fi

if  [[ "${domainlist_check}" == "yes" && -s "${domain_list}" ]]; then
    unset domain
    while read -r domain; do
        # Skip blank lines and comments, and reject malformed entries instead
        # of letting them flow into URLs and filesystem paths.
        [[ -z "${domain}" || "${domain}" =~ ^[[:space:]]*# ]] && continue
        domain="${domain//[[:space:]]/}"
        if ! validate_domain "${domain}"; then
            echo -e "${yellow}$(date +"%d/%m/%Y %H:%M")${reset} ${red}>>${reset} Skipping invalid domain from ${domain_list}: ${domain}"
            continue
        fi
        # In list mode the lock is acquired/released per-target via a
        # subshell so flock's FD goes out of scope when the target finishes.
        (
            collector_acquire_lock "${domain}"
            check_is_known_target "${domain}"
            create_directory_structure
            check_parameter_dependency
            domains_recon
        )
    done < "${domain_list}"
    exit 0
fi

if [[ "${url_check}" == "yes" && -n "${url_verify}" ]]; then
    collector_acquire_lock "${url_domain}"
    check_is_known_target "${url_domain}"
    create_directory_structure
    check_parameter_dependency
    url_recon
fi
