# APIs to subdomain discovery
#
# This is a template — copy it to apis-recon.conf (gitignored) and fill in
# your keys there. collector falls back to this file with blank keys when
# apis-recon.conf doesn't exist, so recon still runs without it; you just
# won't get the enrichment from these OSINT sources.
bevigil_api_key=""
builtwith_api_key=""
builtwith_api_url="https://api.builtwith.com"
c99_api_key=""
censys_api_id=""
censys_api_secret=""
censys_api_url="https://search.censys.io/api/v1"
chaos_api_key=""
commoncrawl_url="http://index.commoncrawl.org/collinfo.json"
dnsdumpster_api_key=""
dnsdumpster_url="https://api.dnsdumpster.com/domain"
fofa_api_key=""
fullhunt_api_key=""
github_token=""
grayhatwarfare_api_key=""
greynoise_api_key=""
hackertarget_url="https://api.hackertarget.com/hostsearch/?q="
hunterhow_api_key=""
intelx_api_key=""
leakix_api_key=""
merklemap_api_key=""
onyphe_api_key=""
publicwww_api_key=""
pulsedive_api_key=""
riskiq_api_key=""
riskiq_api_secret=""
riskiq_api_url="https://api.passivetotal.org/v2/enrichment/subdomains"
securitytrails_api_key=""
securitytrails_api_url="https://api.securitytrails.com/v1"
shodan_apikey=""
shodan_just_scan_main_domain="yes"
shodan_scan_total=1
shodan_use="no"
virustotal_api_key=""
virustotal_api_url="https://www.virustotal.com/api/v3/domains"
whoisxmlapi_api_key=""
whoisxmlapi_hdc_ns_url="https://reverse-dns.whoisxmlapi.com/api/v1"
whoisxmlapi_hdc_whois_url="https://reverse-whois.whoisxmlapi.com/api/v2"
whoisxmlapi_subdomain_url="https://domains-subdomains-discovery.whoisxmlapi.com/api/v1"
