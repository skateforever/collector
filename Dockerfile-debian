# docker build --progress=plain -f ./Dockerfile-debian -t collector:latest .
FROM python:3.12-slim

# Configurações de Ambiente
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    GOROOT=/usr/local/go \
    GOPATH=/go \
    PATH="/usr/local/go/bin:/go/bin:${PATH}" \
    GOBIN=/usr/local/bin

WORKDIR /opt/collector

# 1. Dependências do Sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc git curl wget unzip xz-utils make build-essential procps \
    libpcap-dev libssl-dev libffi-dev libcurl4-openssl-dev \
    jq dnsutils whois html2text chromium nmap sqlite3 libxml2-utils \
    nano vim iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalação do Go
RUN wget -q https://go.dev/dl/go1.26.2.linux-amd64.tar.gz -O /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz && \
    mkdir -p /go

# 3. Ferramentas Go
RUN go install github.com/projectdiscovery/tlsx/cmd/tlsx@latest && \
    go install github.com/projectdiscovery/notify/cmd/notify@latest && \
    go install github.com/projectdiscovery/urlfinder/cmd/urlfinder@latest && \
    go install github.com/tomnomnom/waybackurls@latest && \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    go install github.com/OJ/gobuster/v3@latest && \
    go install github.com/ffuf/ffuf/v2@latest && \
    CGO_ENABLED=1 go install github.com/projectdiscovery/katana/cmd/katana@latest && \
    # Pinned to the v5.1.1 release tag instead of @main — main is an active
    # development branch (confirmed identical to v5.1.1 today, but it's a
    # floating target with no reproducibility guarantee). See sources/amass.sh
    # for why amass now needs a 2-command enum+subs flow.
    CGO_ENABLED=0 go install github.com/owasp-amass/amass/v5/cmd/amass@v5.1.1 && \
    go install github.com/evilsocket/dnssearch@master && \
    # getJS's go.mod is already .../getJS/v2 — installing without the /v2
    # suffix silently resolves @latest to the old v1.0.0 (different deps,
    # years out of date) instead of erroring, since the path is still a
    # technically-valid (if outdated) module.
    go install github.com/003random/getJS/v2@latest && \
    go install github.com/PentestPad/subzy@latest && \
    # subjack's go.mod is "github.com/haccer/subjack" (no /v2, /v3 suffix)
    # even though the repo has tags v2.x/v3.x — Go's major-version-suffix
    # rule makes those tags unresolvable ("invalid version: module contains
    # a go.mod file, so module path must match major version"), which is
    # what breaks the build if subjack is pinned to a release tag. Pinned
    # here to the commit behind the v3.0.0 tag instead, which builds fine.
    go install github.com/haccer/subjack@b53899ce6230767beb1c4a9f879c6ebba23a98fa

# Note: subjack no longer ships fingerprints.json at the repo root, nor a
# runtime "-c <path>" flag to load a custom one — since the subjack/subjack
# v3.0.0 restructuring, fingerprints.json lives at subjack/fingerprints.json
# and is embedded into the binary at build time via go:embed. Nothing to
# download or pass at runtime anymore (see scans/takeover.sh).

# 4. Ferramentas Python
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir dirsearch git-dumper requests shodan sublist3r \
                                flask gunicorn

# dirsearch pulls in the Python httpx/httpx-ntlm packages (step above),
# which install their own console-script stub at /usr/local/bin/httpx —
# the same path GOBIN uses for the real ProjectDiscovery httpx binary
# installed in step 3, so pip's install silently shadows it. `go install`
# itself refuses to just overwrite a non-Go-object file at that path
# ("build output ... already exists and is not an object file"), so the
# stub has to be removed explicitly before reinstalling the real binary.
RUN rm -f /usr/local/bin/httpx && \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest

RUN wget -q https://raw.githubusercontent.com/christophetd/censys-subdomain-finder/master/censys-subdomain-finder.py -O /usr/local/bin/censys-subdomain-finder.py && \
    chmod +x /usr/local/bin/censys-subdomain-finder.py

# 5. Aquatone e MassDNS
RUN wget -q https://github.com/michenriksen/aquatone/releases/download/v1.7.0/aquatone_linux_amd64_1.7.0.zip -O /tmp/aquatone.zip && \
    unzip /tmp/aquatone.zip -d /usr/local/bin && \
    rm /tmp/aquatone.zip

RUN git clone --depth 1 https://github.com/blechschmidt/massdns.git /tmp/massdns && \
    cd /tmp/massdns && make && mv bin/massdns /usr/local/bin/ && rm -rf /tmp/massdns

# 6. Cloudflared (used by start_app_report when cloudflare_tunnel="yes" in
# conf.d/operation.conf). Quick-tunnel mode generates an ephemeral
# https://*.trycloudflare.com URL pointing at the local app-report port,
# so the dashboard can be reached without exposing the VPS IP/port.
RUN wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared && \
    chmod +x /usr/local/bin/cloudflared

# 7. Configuração Final
COPY . .
RUN chmod +x collector collector-docker && chmod +x functions/*.sh && chmod +x scans/*.sh && chmod +x sources/*.sh

# Pin output_dir to the mounted volume path so every run writes results
# to /opt/collector/outputs. The -o/--output CLI flag was removed; to
# control where results land on the host, change the -v mount in
# collector-docker / docker run -v <host_path>:/opt/collector/outputs.
RUN sed -i 's|^output_dir=.*|output_dir="/opt/collector/outputs"|' conf.d/operation.conf

# apis-recon.conf / apis-emails.conf are gitignored and excluded via
# .dockerignore, so only the *.conf.example templates (blank keys) ever
# land in the image — collector's loader falls back to them automatically.
# Real keys are supplied at runtime by bind-mounting conf.d/ from the host
# (see collector-docker / docker-compose.yml).

# Alert provider configs are in support/templates/alerts/ and are baked
# into the image. No pre-creation needed — they're part of the COPY . .
# that brings in the entire repository structure at /opt/collector.

# Expose the app-report (Flask/gunicorn) dashboard port.
EXPOSE 8000

# Volumes: outputs persists recon results across runs; wordlists holds the
# dirsearch/gobuster wordlists mounted from the host; conf.d/ allows
# overriding operation/functions/API-key config at runtime without rebuilding.
VOLUME ["/opt/collector/outputs", "/opt/collector/wordlists"]

# collector is the only entry point — parameters are passed directly:
#   docker run --rm -v $(pwd)/outputs:/opt/collector/outputs collector-image \
#       -d soluti.com.br --recon --webapp-discovery
ENTRYPOINT ["/opt/collector/collector"]
