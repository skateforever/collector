#!/bin/bash
# collector-docker — wrapper that injects the standard volumes and port
#
# Usage is identical to running collector directly:
#   collector-docker -d example.com --recon --webapp-discovery --webapp-short-detection
#   collector-docker -dl /opt/collector/outputs/targets.list --recon --webapp-discovery
#   collector-docker --help
#
# Default path resolution (hybrid):
#   1. If the script is running from a repo checkout (i.e. collector.cfg
#      lives next to the script itself), the defaults point at that
#      checkout — you can run it straight after 'git clone' with no sudo
#      and no need to copy anything into /opt/.
#   2. Otherwise (typical when the binary was installed into
#      /usr/local/bin/), the defaults fall back to /opt/collector/, which
#      is the layout expected when you run 'sudo install ...'.
#   Any variable below can be overridden explicitly in the environment
#   to point at a different path.
#
# Volume mounts strategy:
#   Scripts (collector, functions/, scans/, sources/, support/runtime/)
#   are mounted read-only from the host repo. This means any code change
#   is immediately available without rebuilding the Docker image. The
#   image only needs to be rebuilt when binaries/packages change (i.e.
#   Dockerfile or check_binaries.sh modifications).
#
# Environment variables for overrides:
#   COLLECTOR_IMAGE       — Docker image (default: collector:latest)
#   OUTPUTS_DIR           — outputs directory (default: <root>/outputs)
#   WORDLISTS_DIR         — wordlists directory (default: <root>/wordlists)
#   COLLECTOR_CFG         — path to collector.cfg (default: <root>/collector.cfg)
#   ALERT_PROVIDER_TYPE   — alert provider type: discord, slack, teams, telegram, signal
#                           (default: discord; read from collector.cfg if available)
#   ALERT_PROVIDER_FILE   — path to alert provider config file
#                           (default: <root>/{type}-provider.yaml — optional;
#                           if missing, uses template baked into image)
#   APP_PORT              — dashboard port mapping (default: 127.0.0.1:8000:8000)
#
# Configuration precedence (alert provider type):
#   1. ALERT_PROVIDER_TYPE environment variable (if set)
#   2. collector.cfg notify_config value (if available)
#   3. Default: discord
#
# Installation:
#   sudo install -m 0755 collector-docker /usr/local/bin/collector-docker
#   sudo mkdir -p /opt/collector/{outputs,wordlists}
#   sudo cp collector.cfg /opt/collector/collector.cfg

# Real directory of this script (resolves symlinks and relative paths).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pick the default root: repo checkout if collector.cfg sits next to the
# script, otherwise /opt/collector (installed layout).
if [[ -f "${SCRIPT_DIR}/collector.cfg" ]]; then
    DEFAULT_ROOT="${SCRIPT_DIR}"
else
    DEFAULT_ROOT="/opt/collector"
fi

COLLECTOR_IMAGE="${COLLECTOR_IMAGE:-collector:latest}"
OUTPUTS_DIR="${OUTPUTS_DIR:-${DEFAULT_ROOT}/outputs}"
WORDLISTS_DIR="${WORDLISTS_DIR:-${DEFAULT_ROOT}/wordlists}"
COLLECTOR_CFG="${COLLECTOR_CFG:-${DEFAULT_ROOT}/collector.cfg}"
APP_PORT="${APP_PORT:-127.0.0.1:8000:8000}"

# Determine alert provider type
# Priority: env var > collector.cfg > default
get_alert_provider_type() {
    if [[ -n "${ALERT_PROVIDER_TYPE}" ]]; then
        echo "${ALERT_PROVIDER_TYPE}"
    elif [[ -f "${COLLECTOR_CFG}" ]]; then
        # Extract provider type from notify_config path in collector.cfg
        # e.g., /opt/collector/support/templates/alerts-notify/discord-provider.yaml → discord
        grep "^notify_config=" "${COLLECTOR_CFG}" | \
            sed -E 's|.*alerts/([a-z]+)-provider\.ya?ml.*|\1|' | \
            head -1
    fi
    # Fallback to discord if nothing found
    [[ -z "$1" ]] && echo "discord"
}

ALERT_PROVIDER_TYPE="$(get_alert_provider_type)"
ALERT_PROVIDER_FILE="${ALERT_PROVIDER_FILE:-${DEFAULT_ROOT}/${ALERT_PROVIDER_TYPE}-provider.yaml}"

# Pre-create the host directories that Docker would otherwise auto-create
# as root when mounting them as volumes (which then breaks ownership of
# the outputs produced inside the container).
mkdir -p "${OUTPUTS_DIR}" "${WORDLISTS_DIR}" 2>/dev/null || true

# Sanity check: if COLLECTOR_CFG does not exist (or is a directory), abort
# with a clear message — otherwise Docker would create an empty directory
# on the host and try to mount it on top of the /opt/collector/collector.cfg
# file inside the container, failing with "not a directory".
if [[ ! -f "${COLLECTOR_CFG}" ]]; then
    echo "collector-docker: COLLECTOR_CFG not found: ${COLLECTOR_CFG}" >&2
    echo "  copy collector.cfg to that path, or set COLLECTOR_CFG=<path> in the environment." >&2
    exit 1
fi

# Detect report flags in "$@" so we can:
#   --report-only  → name the container 'collector-report' and refuse if
#                    another one is already running (Docker's --name
#                    collision gives a clear error, no port race).
#   --report-stop  → do NOT spawn a new container; call `docker stop`
#                    on the running one from the host. The in-container
#                    stop_app_report_foreground path is unreachable when
#                    the caller is only the host wrapper (no other
#                    container is running the collector binary), so
#                    dispatching from here is the only way that works.
# Long/short forms are both accepted, matching the collector CLI.
REPORT_CONTAINER_NAME="${REPORT_CONTAINER_NAME:-collector-report}"
want_report_only=no
want_report_stop=no
for arg in "$@"; do
    case "${arg}" in
        -ro|--report-only) want_report_only=yes ;;
        -rs|--report-stop) want_report_stop=yes ;;
    esac
done

# --report-stop wins over --report-only (mirrors the ordering inside
# collector so `--report-only --report-stop` means "stop").
if [[ "${want_report_stop}" == "yes" ]]; then
    if docker ps --format '{{.Names}}' | grep -qx "${REPORT_CONTAINER_NAME}"; then
        docker stop "${REPORT_CONTAINER_NAME}" >/dev/null && \
            echo "collector-docker: stopped ${REPORT_CONTAINER_NAME}"
    else
        echo "collector-docker: no running container named ${REPORT_CONTAINER_NAME}"
    fi
    exit 0
fi

# Host-side port preflight — decides whether to publish APP_PORT.
#
# Three outcomes, all silent about the "why" so the recon path stays
# quiet on happy runs:
#   1. Host port is free → pass -p normally (default behavior).
#   2. Host port is bound by anything at all → omit -p. The recon still
#      completes; if the port is held by a sibling collector container,
#      its dashboard already renders this run's results (shared outputs
#      volume). If it's held by something unrelated, the operator sees
#      no dashboard from this container — a conscious trade-off: never
#      fail a recon over a busy port.
#
# Tool preference: ss > lsof > netstat. If none are present we skip the
# check and let Docker itself decide (which usually means it fails, but
# only in the rare case where the port is genuinely taken and no tool
# is available to detect it beforehand).
host_port=""
if [[ "${APP_PORT}" =~ ^[0-9.]+:([0-9]+):[0-9]+$ ]]; then
    host_port="${BASH_REMATCH[1]}"
elif [[ "${APP_PORT}" =~ ^([0-9]+):[0-9]+$ ]]; then
    host_port="${BASH_REMATCH[1]}"
fi

port_args=(-p "${APP_PORT}")
if [[ -n "${host_port}" ]]; then
    port_busy=no
    if command -v ss >/dev/null 2>&1; then
        ss -H -ltn "sport = :${host_port}" 2>/dev/null | grep -q . && port_busy=yes
    elif command -v lsof >/dev/null 2>&1; then
        lsof -iTCP:"${host_port}" -sTCP:LISTEN -Pn 2>/dev/null | grep -q . && port_busy=yes
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${host_port}$" && port_busy=yes
    fi
    if [[ "${port_busy}" == "yes" ]]; then
        port_args=()
    fi
fi

# The alert provider mount is OPT-IN — only injected when the host file exists.
# Without it, collector uses the default template baked into the image at
# /opt/collector/support/templates/alerts-notify/{type}-provider.yaml.
# This is intentional: a missing custom config is not an error.
alert_mount_args=()
if [[ -s "${ALERT_PROVIDER_FILE}" ]]; then
    alert_mount_args=(-v "${ALERT_PROVIDER_FILE}:/opt/collector/support/templates/alerts-notify/${ALERT_PROVIDER_TYPE}-provider.yaml:ro")
fi

# Only the report-only container needs a stable name (so --report-stop
# from another shell can find it). Recon containers stay anonymous.
name_args=()
if [[ "${want_report_only}" == "yes" ]]; then
    if docker ps --format '{{.Names}}' | grep -qx "${REPORT_CONTAINER_NAME}"; then
        echo "collector-docker: container '${REPORT_CONTAINER_NAME}' is already running." >&2
        echo "  stop it first with: collector-docker --report-stop" >&2
        exit 1
    fi
    name_args=(--name "${REPORT_CONTAINER_NAME}")
fi

# Mount scripts from the host so the container always uses the latest code
# without requiring a Docker image rebuild. The image only needs to provide
# the compiled binaries (Go tools, Python packages, system utilities).
script_mount_args=()
if [[ -d "${DEFAULT_ROOT}/functions" ]]; then
    script_mount_args+=(
        -v "${DEFAULT_ROOT}/collector:/opt/collector/collector:ro"
        -v "${DEFAULT_ROOT}/functions:/opt/collector/functions:ro"
        -v "${DEFAULT_ROOT}/scans:/opt/collector/scans:ro"
        -v "${DEFAULT_ROOT}/sources:/opt/collector/sources:ro"
    )
    [[ -d "${DEFAULT_ROOT}/support/runtime" ]] && \
        script_mount_args+=(-v "${DEFAULT_ROOT}/support/runtime:/opt/collector/support/runtime:ro")
    [[ -d "${DEFAULT_ROOT}/support/templates/alerts" ]] && \
        script_mount_args+=(-v "${DEFAULT_ROOT}/support/templates/alerts:/opt/collector/support/templates/alerts:ro")
fi

exec docker run --rm "${name_args[@]}" \
    -e "TERM=${TERM:-dumb}" \
    -v "${OUTPUTS_DIR}:/opt/collector/outputs" \
    -v "${WORDLISTS_DIR}:/opt/collector/wordlists" \
    -v "${COLLECTOR_CFG}:/opt/collector/collector.cfg:ro" \
    "${script_mount_args[@]}" \
    "${alert_mount_args[@]}" \
    "${port_args[@]}" \
    "${COLLECTOR_IMAGE}" \
    "$@"
