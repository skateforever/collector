#!/bin/bash
# collector-docker — wrapper que injeta volumes e porta padrão
#
# Uso idêntico ao collector direto:
#   collector-docker -d example.com --recon --webapp-discovery --webapp-short-detection
#   collector-docker -dl /opt/collector/outputs/targets.list --recon --webapp-discovery
#   collector-docker --help
#
# Variáveis de ambiente para override:
#   COLLECTOR_IMAGE   — imagem Docker (default: collector:latest)
#   OUTPUTS_DIR       — diretório de outputs (default: /opt/collector/outputs)
#   WORDLISTS_DIR     — diretório de wordlists (default: /opt/collector/wordlists)
#   COLLECTOR_CFG     — path do collector.cfg (default: /opt/collector/collector.cfg)
#   NOTIFY_CONFIG     — path do provider-config do notify
#                       (default: /opt/collector/notify-provider.yaml — opcional;
#                       se o host não tiver esse arquivo, a flag -v abaixo cria
#                       um diretório vazio e o collector cai no fallback default).
#   APP_PORT          — mapeamento da porta do dashboard (default: 127.0.0.1:8000:8000)
#
# Instalação:
#   sudo install -m 0755 collector-docker /usr/local/bin/collector-docker

COLLECTOR_IMAGE="${COLLECTOR_IMAGE:-collector:latest}"
OUTPUTS_DIR="${OUTPUTS_DIR:-/opt/collector/outputs}"
WORDLISTS_DIR="${WORDLISTS_DIR:-/opt/collector/wordlists}"
COLLECTOR_CFG="${COLLECTOR_CFG:-/opt/collector/collector.cfg}"
NOTIFY_CONFIG="${NOTIFY_CONFIG:-/opt/collector/notify-provider.yaml}"
APP_PORT="${APP_PORT:-127.0.0.1:8000:8000}"

# The notify mount is OPT-IN — only injected when the host file exists.
# Without it, every `notify ... -pc /etc/collector/notify-provider.yaml`
# call inside the container will print a 'config not found' line on stderr
# (visible in log_execution_file). That's intentional: a missing mount
# should be loud, not silent. To opt out cleanly, edit collector.cfg and
# drop -pc from notify_options.
notify_mount_args=()
if [[ -s "${NOTIFY_CONFIG}" ]]; then
    notify_mount_args=(-v "${NOTIFY_CONFIG}:/etc/collector/notify-provider.yaml:ro")
fi

exec docker run --rm \
    -v "${OUTPUTS_DIR}:/opt/collector/outputs" \
    -v "${WORDLISTS_DIR}:/opt/collector/wordlists" \
    -v "${COLLECTOR_CFG}:/opt/collector/collector.cfg:ro" \
    "${notify_mount_args[@]}" \
    -p "${APP_PORT}" \
    "${COLLECTOR_IMAGE}" \
    "$@"
