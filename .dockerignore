# Real API key files must never be baked into an image layer — they're
# meant to be bind-mounted at runtime (see collector-docker / docker-compose.yml).
# .gitignore keeps them out of git, but COPY inside the Dockerfile reads
# straight off the build-context filesystem regardless of git, so they
# need to be excluded here too.
conf.d/apis-recon.conf
conf.d/apis-emails.conf

.git/
outputs/
wordlists/
